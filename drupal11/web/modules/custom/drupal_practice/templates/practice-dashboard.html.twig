<div class="practice-dashboard">

  {# <h1>{{ 'Practice Dashboard'|t }}</h1> #}

  <div class="practice-statistics">

    <div class="stat">
      <strong>{{ statistics.tasks }}</strong>
      <span>{{ 'Tasks'|t }}</span>
    </div>

    <div class="stat">
      <strong>{{ statistics.completed }}</strong>
      <span>{{ 'Completed'|t }}</span>
    </div>

    <div class="stat">
      <strong>{{ statistics.pending }}</strong>
      <span>{{ 'Pending'|t }}</span>
    </div>

  </div>

</div>