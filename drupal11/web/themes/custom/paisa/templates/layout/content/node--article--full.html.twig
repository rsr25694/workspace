<article class="article article--full">

  <header class="article__header">
    <h1>{{ label }}</h1>

    {% if display_submitted %}
      <div class="article__meta">
        {{ author_name }}
        ·
        {{ date }}
      </div>
    {% endif %}
  </header>

  <div class="article__content">
    {{ content }}
  </div>

</article>